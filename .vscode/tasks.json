{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build & Package Full APK",
            "type": "shell",
            "command": "bash scripts/build_native.sh && bash scripts/package_apk.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Build Native (ARM64)",
            "type": "shell",
            "command": "bash scripts/build_native.sh",
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Package APK",
            "type": "shell",
            "command": "bash scripts/package_apk.sh",
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        },
        {
            "label": "Run UI Tests",
            "type": "shell",
            "command": "TMP_EXEC=\"${TMPDIR:-/data/local/tmp}/ui_test\"; mkdir -p \"$(dirname \"$TMP_EXEC\")\" && cp build-m2/ui_test \"$TMP_EXEC\" && chmod +x \"$TMP_EXEC\" && \"$TMP_EXEC\"",
            "group": "test",
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            }
        }
    ]
}
