<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Pig">
    <soundtype name="Select">
      <soundset name="PigSelect"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="PigDeath"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="PigAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>