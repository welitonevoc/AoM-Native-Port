<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Scout">
    <soundtype name="Select">
      <soundset name="MilitaryGreekSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="CavalryGruntNoMetal"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="MaleDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="MilitaryGreekAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>