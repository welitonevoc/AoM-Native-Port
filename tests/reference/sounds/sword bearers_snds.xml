<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Sword Bearers">
    <soundtype name="Select">
      <soundset name="VillagerEgyptianSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="MaleGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="VillagerEgyptianAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>