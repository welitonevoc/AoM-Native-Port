<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Caravan Greek">
    <soundtype name="Select">
      <soundset name="CaravanSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="CaravanGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="CaravanDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="CaravanGreekBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="CaravanAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>