<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Dwarf">
    <soundtype name="Select">
      <soundset name="DwarfSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="DwarfGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="DwarfDie"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="VillagerBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="DwarfAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="DwarfAttack"></soundset>
        </choice>
        <choice name="Huntable">
          <soundset name="DwarfHunt"></soundset>
        </choice>
        <choice name="Fish">
          <soundset name="DwarfFish"></soundset>
        </choice>
        <choice name="Farm">
          <soundset name="DwarfFarm"></soundset>
        </choice>
        <choice name="Berry Bush">
          <soundset name="DwarfForage"></soundset>
        </choice>
        <choice name="Tree">
          <soundset name="DwarfLumberjack"></soundset>
        </choice>
        <choice name="Gold">
          <soundset name="DwarfMine"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>