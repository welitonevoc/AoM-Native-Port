<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Setna">
    <soundtype name="Select">
      <soundset name="SetnaSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="SetnaGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="SetnaDie"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="HeroBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="SetnaAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="SetnaAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>