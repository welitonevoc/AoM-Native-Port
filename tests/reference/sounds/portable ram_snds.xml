<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Portable Ram">
    <soundtype name="Select">
      <soundset name="MilitaryNorseSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="MaleGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="MilitaryNorseAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="MilitaryNorseAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>