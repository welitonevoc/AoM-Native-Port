<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Ox Cart">
    <soundtype name="Select">
      <soundset name="VillagerNorseSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="OxCartGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="CaravanNorseDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="VillagerBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="VillagerNorseAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>