<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Roc">
    <soundtype name="Select">
      <soundset name="RocSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="RocGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="RocDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="RocAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>