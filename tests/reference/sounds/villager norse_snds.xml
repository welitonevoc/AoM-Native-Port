<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Villager Norse">
    <soundtype name="Select">
      <variationlogic>
        <choice name="0">
          <soundset name="VillagerNorseSelect"></soundset>
        </choice>
        <choice name="1">
          <soundset name="VillagerNorseFemaleSelect"></soundset>
        </choice>
      </variationlogic>
    </soundtype>
    <soundtype name="Grunt">
      <variationlogic>
        <choice name="0">
          <soundset name="MaleGrunt"></soundset>
        </choice>
        <choice name="1">
          <soundset name="FemaleGrunt"></soundset>
        </choice>
      </variationlogic>
    </soundtype>
    <soundtype name="Death">
      <variationlogic>
        <choice name="0">
          <soundset name="MaleDeath"></soundset>
        </choice>
        <choice name="1">
          <soundset name="FemaleDeath"></soundset>
        </choice>
      </variationlogic>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="VillagerBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <variationlogic>
        <choice name="0">
          <targetlogic>
            <choice name="default">
              <soundset name="VillagerNorseAcknowledge"></soundset>
            </choice>
            <choice name="enemy">
              <soundset name="VillagerNorseAttack"></soundset>
            </choice>
            <choice name="Berry Bush">
              <soundset name="VillagerNorseForage"></soundset>
            </choice>
            <choice name="Farm">
              <soundset name="VillagerNorseFarm"></soundset>
            </choice>
            <choice name="Tree">
              <soundset name="VillagerNorseLumberjack"></soundset>
            </choice>
            <choice name="Gold">
              <soundset name="VillagerNorseMine"></soundset>
            </choice>
            <choice name="Fish">
              <soundset name="VillagerNorseFish"></soundset>
            </choice>
            <choice name="Huntable">
              <soundset name="VillagerNorseHunt"></soundset>
            </choice>
          </targetlogic>
        </choice>
        <choice name="1">
          <targetlogic>
            <choice name="default">
              <soundset name="VillagerNorseFemaleAcknowledge"></soundset>
            </choice>
            <choice name="enemy">
              <soundset name="VillagerNorseFemaleAttack"></soundset>
            </choice>
            <choice name="Berry Bush">
              <soundset name="VillagerNorseFemaleForage"></soundset>
            </choice>
            <choice name="Farm">
              <soundset name="VillagerNorseFemaleFarm"></soundset>
            </choice>
            <choice name="Tree">
              <soundset name="VillagerNorseFemaleLumberjack"></soundset>
            </choice>
            <choice name="Gold">
              <soundset name="VillagerNorseFemaleMine"></soundset>
            </choice>
            <choice name="Fish">
              <soundset name="VillagerNorseFemaleFish"></soundset>
            </choice>
            <choice name="Huntable">
              <soundset name="VillagerNorseFemaleHunt"></soundset>
            </choice>
          </targetlogic>
        </choice>
      </variationlogic>
    </soundtype>
  </protounit>
</protounitsounddef>