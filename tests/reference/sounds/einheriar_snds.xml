<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Einheriar">
    <soundtype name="Select">
      <soundset name="EinheriarSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="EinheriarGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="MetalSlice"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="MetalSlice"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="EinheriarDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="EinheriarAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="EinheriarAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>