<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Great Box Cart 2">
    <soundtype name="Select">
      <soundset name="CaravanEgyptianSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="CaravanEgyptianGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushWood"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackWood"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackWood"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceWood"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackWood"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="CaravanEgyptianDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="VillagerBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="CaravanEgyptianAcknowledge"></soundset>
    </soundtype>
