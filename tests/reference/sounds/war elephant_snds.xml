<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="War Elephant">
    <soundtype name="Select">
      <soundset name="MilitaryEgyptianSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="WarElephantGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="MetalSlice"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="MetalSlice"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="WarElephantDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MilitaryBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="MilitaryEgyptianAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="MilitaryEgyptianAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>