<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Phoenix">
    <soundtype name="Select">
      <soundset name="PhoenixSelect"></soundset>
    </soundtype>
    <soundtype name="Attack">
      <soundset name="placeholder"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="PhoenixGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="placeholder"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Move">
      <soundset name="PlaceHolder"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="PhoenixAcknowledge"></soundset>
    </soundtype>
    <soundtype name="Exists">
      <soundset name="FireGiantExist"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>