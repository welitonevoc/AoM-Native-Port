<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Valkyrie">
    <soundtype name="Select">
      <soundset name="ValkyrieSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="FemaleCavalryGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="MetalSlice"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="MetalSlice"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="FemaleDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="ValkyrieAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="ValkyrieAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>