<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Fire Giant">
    <soundtype name="Select">
      <soundset name="FireGiantSelect"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="FireGiantDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="FireGiantAcknowledge"></soundset>
    </soundtype>
    <soundtype name="Exists">
      <soundset name="FireGiantExist"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>