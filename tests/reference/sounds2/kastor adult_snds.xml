<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Kastor Adult">
    <soundtype name="Select">
      <soundset name="KastorAdultSelect"></soundset>
    </soundtype>
    <soundtype name="Attack">
      <soundset name="KastorAdultAttack"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="KastorAdultGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="MetalSlice"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="MetalSlice"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="KastorAdultDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="HeroBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="KastorAdultAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="KastorAdultAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>