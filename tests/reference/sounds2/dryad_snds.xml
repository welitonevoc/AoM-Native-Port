<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Dryad">
    <soundtype name="Select">
      <soundset name="DryadSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="DryadGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushWood"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="TreeHit"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="TreeHit"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceWood"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="TreeHit"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="DryadDeath"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="DryadAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="DryadAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>