<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Automaton">
    <soundtype name="Select">
      <soundset name="AutomatonSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="AutomatonGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushMetal"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackMetal"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackMetal"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceMetal"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackMetal"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="AutomatonDie"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="AutomatonAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="AutomatonAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>