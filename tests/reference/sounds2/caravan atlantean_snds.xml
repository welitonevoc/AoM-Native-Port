<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Caravan Atlantean">
    <soundtype name="Select">
      <soundset name="LlamaCaravanSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="LlamaCaravanGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="LlamaCaravanDie"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="LlamaCaravanBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="LlamaCaravanMove"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>