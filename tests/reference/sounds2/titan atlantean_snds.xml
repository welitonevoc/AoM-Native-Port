        </choice>
        <choice name="Atlantean">
          <soundset name="TitanSelect"></soundset>
        </choice>
      </culturelogic>
    </soundtype>
    <soundtype name="Grunt">
      <culturelogic>
        <choice name="Greek">
          <soundset name="TitanGreekGrunt"></soundset>
        </choice>
        <choice name="Egyptian">
          <soundset name="TitanEgyptianGrunt"></soundset>
        </choice>
        <choice name="Norse">
          <soundset name="TitanNorseGrunt"></soundset>
        </choice>
        <choice name="Atlantean">
          <soundset name="TitanGrunt"></soundset>
