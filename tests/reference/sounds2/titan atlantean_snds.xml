<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Titan Atlantean">
    <soundtype name="Select">
      <culturelogic>
        <choice name="Greek">
          <soundset name="TitanGreekSelect"></soundset>
        </choice>
        <choice name="Egyptian">
          <soundset name="TitanEgyptianSelect"></soundset>
        </choice>
        <choice name="Norse">
