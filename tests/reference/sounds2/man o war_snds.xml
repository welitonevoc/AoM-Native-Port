<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Man O War">
    <soundtype name="Select">
      <soundset name="ManowarSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="ManowarGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="ManowarDie"></soundset>
    </soundtype>
    <soundtype name="Creation">
      <soundset name="MythUnitBirth"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <soundset name="ManowarAcknowledge"></soundset>
    </soundtype>
  </protounit>
</protounitsounddef>