<?xml version="1.0" encoding="utf-8"?>
<protounitsounddef>
  <protounit name="Titan Gaia">
    <soundtype name="Select">
      <soundset name="GaiaSelect"></soundset>
    </soundtype>
    <soundtype name="Grunt">
      <soundset name="GaiaGrunt"></soundset>
    </soundtype>
    <soundtype name="Hit">
      <damagetypelogic>
        <choice name="Crush">
          <soundset name="CrushFlesh"></soundset>
        </choice>
        <choice name="Fire">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Hack">
          <soundset name="HackFlesh"></soundset>
        </choice>
        <choice name="Pierce">
          <soundset name="PierceFlesh"></soundset>
        </choice>
        <choice name="Slash">
          <soundset name="HackFlesh"></soundset>
        </choice>
      </damagetypelogic>
    </soundtype>
    <soundtype name="Death">
      <soundset name="GaiaDie"></soundset>
    </soundtype>
    <soundtype name="Acknowledge">
      <targetlogic>
        <choice name="default">
          <soundset name="GaiaAcknowledge"></soundset>
        </choice>
        <choice name="enemy">
          <soundset name="GaiaAttack"></soundset>
        </choice>
      </targetlogic>
    </soundtype>
  </protounit>
</protounitsounddef>